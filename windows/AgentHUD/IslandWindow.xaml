<Window x:Class="AgentHUD.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AgentHUD"
        Title="Agent HUD" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False" ResizeMode="NoResize"
        Width="420" Height="720" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12" Foreground="White">
  <!-- One display's island (TASK.md §3: the notch's stand-in at the top centre). The window is as large as the open
       panel and transparent around the island, so the pixels outside it take no clicks; it never takes the focus. -->
  <Window.Resources>
    <local:LevelBrush x:Key="Level" />
    <local:FractionWidth x:Key="Fraction" />
    <local:Shown x:Key="Shown" />
    <SolidColorBrush x:Key="Ground" Color="#F2121214" />
    <SolidColorBrush x:Key="Card" Color="#FF1F1F22" />
    <SolidColorBrush x:Key="Secondary" Color="#FF9A9AA0" />
    <SolidColorBrush x:Key="Track" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="Inset" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="Highlight" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="Border" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="Tertiary" Color="#FF6E6E73" />

    <DataTemplate x:Key="MarkTemplate">
      <Grid Width="20" Height="20">
        <Image Source="{Binding Image}" Visibility="{Binding Image, Converter={StaticResource Shown}}" />
        <Border CornerRadius="5" Background="#33FFFFFF" Visibility="{Binding Image, Converter={StaticResource Shown}, ConverterParameter=invert}">
          <TextBlock Text="{Binding Initial}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </Grid>
    </DataTemplate>

    <!-- The island draws its own look whatever theme the application's normal windows take: these implicit styles,
         nearer than the application's, keep the Fluent theme's off its buttons and scroll bars. -->
    <Style TargetType="Button" />
    <Style TargetType="ScrollViewer" />
    <!-- The island's fields draw nothing but their text and caret. -->
    <Style TargetType="TextBox">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Hidden" Background="Transparent" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CardButton" TargetType="Button">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Padding" Value="12,4" />
      <Setter Property="Margin" Value="6,0,0,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Face" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" Padding="{TemplateBinding Padding}">
              <ContentPresenter x:Name="Label" HorizontalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Opacity" Value="0.85" /></Trigger>
              <!-- Not ready (a question without an answer yet): the plain highlight and tertiary text, as on macOS. -->
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Face" Property="Background" Value="#2EFFFFFF" />
                <Setter TargetName="Face" Property="BorderBrush" Value="Transparent" />
                <Setter TargetName="Label" Property="TextElement.Foreground" Value="#FF6E6E73" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Border x:Name="Island" HorizontalAlignment="Center" VerticalAlignment="Top" Background="{StaticResource Ground}"
            CornerRadius="0,0,14,14" SnapsToDevicePixels="True">
      <!-- The HUD's rest (the news line or the marks) on its edge, the panel opening inward from it (ApplyPlacement). -->
      <DockPanel x:Name="IslandLayout" LastChildFill="True">
        <StackPanel x:Name="RestPart" DockPanel.Dock="Top" Background="Transparent" Cursor="SizeAll"
                    PreviewMouseLeftButtonDown="OnRestDown" PreviewMouseMove="OnRestMove" PreviewMouseLeftButtonUp="OnRestUp">
        <!-- At rest with news: its mark, its agent, and the engine's short line in the news's accent. -->
        <ContentControl Content="{Binding Event}" Focusable="False" Margin="14,7,14,8"
                        Visibility="{Binding ShowsEventLine, Converter={StaticResource Shown}}">
          <ContentControl.ContentTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal">
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource MarkTemplate}" Width="17" Height="17" />
                <TextBlock Text="{Binding Copy.VendorName}" FontWeight="SemiBold" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center" />
                <Ellipse Width="6" Height="6" Fill="{Binding Accent}" Margin="16,0,6,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Copy.CompactTitle}" Foreground="{Binding Accent}" FontWeight="Medium" VerticalAlignment="Center"
                           MaxWidth="220" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </DataTemplate>
          </ContentControl.ContentTemplate>
        </ContentControl>
        <!-- At rest: Core's logo queue, a mark each; a mark whose agent waits on the user wears a sign. -->
        <ItemsControl x:Name="MarksList" ItemsSource="{Binding Marks}" Margin="10,2,10,3"
                      Visibility="{Binding ShowsMarks, Converter={StaticResource Shown}}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="4">
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource MarkTemplate}" />
                <Ellipse Width="7" Height="7" Fill="{x:Static local:LevelBrush.Warning}" Stroke="#FF121214" StrokeThickness="1.5"
                         HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-3,0"
                         Visibility="{Binding Mark.Waiting, Converter={StaticResource Shown}}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        </StackPanel>

        <!-- Open: the event panel while requests wait (the open one whole, the rest a line each), else the usage panel.
             It follows its content up to the display's height less 80 pt (PanelMaxHeight) and scrolls beyond. -->
        <ScrollViewer x:Name="PanelScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                      Visibility="{Binding ShowsPanel, Converter={StaticResource Shown}}">
        <StackPanel x:Name="PanelContent" Width="400" Margin="0,8,0,10">
          <TextBlock Text="{Binding Error}" Foreground="{x:Static local:LevelBrush.Warning}" Margin="16,0,16,6" TextWrapping="Wrap"
                     Visibility="{Binding Error, Converter={StaticResource Shown}}" />

          <!-- Hovered news: the Desktop's detail card in the engine's words — its agent, badge, sentence, figures and
               bar; a reply's status and task. Its button opens the statistics, or puts a reply away. -->
          <ContentControl Content="{Binding Event}" Focusable="False" Visibility="{Binding ShowsEventCard, Converter={StaticResource Shown}}">
            <ContentControl.ContentTemplate>
              <DataTemplate>
                <StackPanel Margin="18,4,18,4">
                  <Grid>
                    <StackPanel Orientation="Horizontal">
                      <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource MarkTemplate}" Width="22" Height="22" />
                      <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Copy.VendorName}" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock Text="{Binding Copy.AgentName}" FontSize="10" Foreground="{StaticResource Secondary}"
                                   Visibility="{Binding Copy.AgentName, Converter={StaticResource Shown}}" />
                      </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                      <Ellipse Width="5" Height="5" Fill="{Binding Accent}" Margin="0,0,5,0" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding Copy.Badge}" FontSize="10" FontWeight="Medium" Foreground="{Binding Accent}"
                                 Visibility="{Binding Copy.Badge, Converter={StaticResource Shown}}" />
                      <TextBlock Text="{Binding Copy.CompactTitle}" FontSize="10" FontWeight="Medium" Foreground="{Binding Accent}"
                                 Visibility="{Binding IsReply, Converter={StaticResource Shown}}" />
                    </StackPanel>
                  </Grid>
                  <TextBlock Text="{Binding Copy.Title}" Foreground="#94FFFFFF" FontSize="12" Margin="0,16,0,0" TextWrapping="Wrap" />
                  <ItemsControl ItemsSource="{Binding Copy.Metrics}" Margin="0,16,0,0">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <StackPanel>
                          <TextBlock Text="{Binding Value}" FontSize="23" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Label}" FontSize="10" Foreground="#66FFFFFF" Margin="0,4,0,0" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <StackPanel Margin="0,16,0,0" Visibility="{Binding HasUsage, Converter={StaticResource Shown}}">
                    <Grid>
                      <TextBlock Text="{Binding Copy.AgentName}" FontSize="10" Foreground="#6BFFFFFF" />
                      <TextBlock Text="{Binding Copy.Metrics[0].Value}" FontSize="10" Foreground="#6BFFFFFF" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid Height="4" Margin="0,7,0,0">
                      <Border CornerRadius="2" Background="{StaticResource Track}" />
                      <Border CornerRadius="2" HorizontalAlignment="Left" Background="{Binding Accent}"
                              Width="{Binding UsedFraction, Converter={StaticResource Fraction}, ConverterParameter=364}" />
                    </Grid>
                    <TextBlock Text="{Binding Copy.OtherLimits}" FontSize="10" Foreground="{Binding Accent}" Margin="0,7,0,0" TextWrapping="Wrap"
                               Visibility="{Binding Copy.OtherLimits, Converter={StaticResource Shown}}" />
                  </StackPanel>
                  <Button Style="{StaticResource CardButton}" Content="{Binding Action}" Tag="{Binding}" Click="OnEventAction"
                          Margin="0,16,0,4" Padding="12,7" HorizontalAlignment="Stretch" Background="{Binding Accent}"
                          BorderBrush="{Binding Accent}" Foreground="Black" />
                </StackPanel>
              </DataTemplate>
            </ContentControl.ContentTemplate>
          </ContentControl>

          <StackPanel Visibility="{Binding ShowsEvents, Converter={StaticResource Shown}}">
          <!-- The open request's card: the same CardModel while the request waits, so its fields keep what is typed. -->
          <ContentControl Content="{Binding OpenCard}" Focusable="False">
            <ContentControl.ContentTemplate>
              <DataTemplate>
                <Border Background="{StaticResource Card}" CornerRadius="10" Margin="10,0,10,8" Padding="12,10">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource MarkTemplate}" Width="16" Height="16" />
                      <TextBlock Text="{Binding KindText}" Margin="8,0,0,0" Foreground="{StaticResource Secondary}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding Request.Summary}" FontWeight="SemiBold" FontSize="13" Margin="0,6,0,0" TextWrapping="Wrap" />

                    <!-- A plain request: what an allow lets run, the rule Always allow adds, and the answers. -->
                    <StackPanel Visibility="{Binding IsPlain, Converter={StaticResource Shown}}">
                      <Border Background="{StaticResource Inset}" CornerRadius="7" Margin="0,6,0,0" Padding="8,6"
                              Visibility="{Binding Subject, Converter={StaticResource Shown}}">
                        <TextBlock Text="{Binding Subject}" Foreground="{StaticResource Secondary}" TextWrapping="Wrap" MaxHeight="96"
                                   TextTrimming="CharacterEllipsis" FontFamily="Cascadia Mono, Consolas" FontSize="11" />
                      </Border>
                      <TextBlock Text="{Binding AlwaysRule}" Foreground="{StaticResource Secondary}" FontSize="11" Margin="0,6,0,0"
                                 TextWrapping="Wrap" Visibility="{Binding AlwaysRule, Converter={StaticResource Shown}}" />
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Style="{StaticResource CardButton}" Content="{Binding Deny}" Tag="{Binding}" Click="OnDeny"
                                Background="#33FF453A" BorderBrush="#99FF453A" />
                        <Button Style="{StaticResource CardButton}" Content="{Binding Always}" Tag="{Binding}" Click="OnAlways"
                                Background="Transparent" BorderBrush="#9930D158"
                                Visibility="{Binding OffersAlways, Converter={StaticResource Shown}}" />
                        <Button Style="{StaticResource CardButton}" Content="{Binding Allow}" Tag="{Binding}" Click="OnAllow"
                                Background="#FF30D158" BorderBrush="#FF30D158" Foreground="Black" />
                      </StackPanel>
                    </StackPanel>

                    <!-- A question, one at a time: its offered answers, the user's own words, Skip, Back, Next or Submit. -->
                    <StackPanel Visibility="{Binding IsQuestion, Converter={StaticResource Shown}}" Margin="0,8,0,0">
                      <StackPanel Orientation="Horizontal">
                        <Border Background="#24FF9F0A" CornerRadius="4" Padding="5,1" Margin="0,0,7,0" VerticalAlignment="Top"
                                Visibility="{Binding PageText, Converter={StaticResource Shown}}">
                          <TextBlock Text="{Binding PageText}" FontSize="10" FontWeight="SemiBold" Foreground="{x:Static local:LevelBrush.Warning}" />
                        </Border>
                        <TextBlock Text="{Binding QuestionText}" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="340" />
                      </StackPanel>
                      <TextBlock Text="{Binding ChooseAny}" FontSize="10" Foreground="{StaticResource Tertiary}" Margin="0,4,0,0"
                                 Visibility="{Binding MultiSelect, Converter={StaticResource Shown}}" />
                      <ItemsControl ItemsSource="{Binding Options}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Button Tag="{Binding}" Click="OnPickOption" Focusable="False" Cursor="Hand" Margin="0,0,0,3">
                              <Button.Template>
                                <ControlTemplate TargetType="Button">
                                  <Border x:Name="Row" Background="{StaticResource Inset}" CornerRadius="7" Padding="9,7">
                                    <ContentPresenter />
                                  </Border>
                                  <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Picked}" Value="True">
                                      <Setter TargetName="Row" Property="Background" Value="{StaticResource Highlight}" />
                                    </DataTrigger>
                                  </ControlTemplate.Triggers>
                                </ControlTemplate>
                              </Button.Template>
                              <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Marker}" Foreground="White" FontSize="11" />
                                <StackPanel Grid.Column="1">
                                  <TextBlock Text="{Binding Option.Label}" Foreground="White" FontWeight="Medium" TextWrapping="Wrap" />
                                  <TextBlock Text="{Binding Option.Description}" Foreground="{StaticResource Secondary}" FontSize="11"
                                             TextWrapping="Wrap" Visibility="{Binding Option.Description, Converter={StaticResource Shown}}" />
                                </StackPanel>
                              </Grid>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <Border CornerRadius="7" Padding="9,7" Background="{StaticResource Inset}" Tag="{Binding}"
                              MouseLeftButtonDown="OnChooseOwn">
                        <StackPanel>
                          <TextBlock Text="{Binding OwnLabel}" FontWeight="Medium" />
                          <Grid Margin="0,3,0,0">
                            <TextBox x:Name="OwnField" Text="{Binding OwnText, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding}"
                                     Background="Transparent" Foreground="White" CaretBrush="White" BorderThickness="0" Padding="0"
                                     PreviewMouseLeftButtonDown="OnFieldClicked" PreviewKeyDown="OnOwnKey" />
                            <TextBlock Text="{Binding OwnPlaceholder}" Foreground="{StaticResource Tertiary}" IsHitTestVisible="False"
                                       Visibility="{Binding Text, ElementName=OwnField, Converter={StaticResource Shown}, ConverterParameter=invert}" />
                          </Grid>
                        </StackPanel>
                      </Border>
                      <Grid Margin="0,10,0,0">
                        <Button Style="{StaticResource CardButton}" Content="{Binding Skip}" Tag="{Binding}" Click="OnSkip" Margin="0"
                                Background="Transparent" BorderBrush="{StaticResource Border}" Foreground="{StaticResource Secondary}"
                                HorizontalAlignment="Left" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                          <Button Style="{StaticResource CardButton}" Content="{Binding Back}" Tag="{Binding}" Click="OnBack"
                                  Background="Transparent" BorderBrush="{StaticResource Border}" Foreground="{StaticResource Secondary}"
                                  Visibility="{Binding CanGoBack, Converter={StaticResource Shown}}" />
                          <Button Style="{StaticResource CardButton}" Content="{Binding NextText}" Tag="{Binding}" Click="OnNext"
                                  IsEnabled="{Binding Ready}" Background="#FF30D158" BorderBrush="#FF30D158" Foreground="Black" />
                        </StackPanel>
                      </Grid>
                    </StackPanel>

                    <!-- A plan to read, then Approve, Approve and accept edits, or Keep planning with a note. -->
                    <StackPanel Visibility="{Binding IsPlan, Converter={StaticResource Shown}}" Margin="0,8,0,0">
                      <Border Background="{StaticResource Inset}" CornerRadius="7">
                        <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto" Focusable="False">
                          <TextBox Text="{Binding PlanText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent"
                                   Foreground="White" BorderThickness="0" Padding="9" FontSize="11" Focusable="False" />
                        </ScrollViewer>
                      </Border>
                      <Grid Margin="0,8,0,0" Visibility="{Binding NotNoting, Converter={StaticResource Shown}}">
                        <Button Style="{StaticResource CardButton}" Content="{Binding KeepPlanning}" Tag="{Binding}" Click="OnKeepPlanning"
                                Margin="0" Background="Transparent" BorderBrush="{StaticResource Border}" Foreground="{StaticResource Secondary}"
                                HorizontalAlignment="Left" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                          <Button Style="{StaticResource CardButton}" Content="{Binding ApproveEdits}" Tag="{Binding}" Click="OnApproveEdits"
                                  Background="Transparent" BorderBrush="#6630D158" Foreground="{x:Static local:LevelBrush.Ok}" />
                          <Button Style="{StaticResource CardButton}" Content="{Binding Approve}" Tag="{Binding}" Click="OnApprove"
                                  Background="#FF30D158" BorderBrush="#FF30D158" Foreground="Black" />
                        </StackPanel>
                      </Grid>
                      <StackPanel Margin="0,8,0,0" Visibility="{Binding Noting, Converter={StaticResource Shown}}">
                        <Border Background="{StaticResource Inset}" CornerRadius="7" Padding="9,7">
                          <Grid>
                            <TextBox x:Name="NoteField" Text="{Binding NoteText, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding}"
                                     Background="Transparent" Foreground="White" CaretBrush="White" BorderThickness="0" Padding="0"
                                     PreviewMouseLeftButtonDown="OnFieldClicked" PreviewKeyDown="OnNoteKey" />
                            <TextBlock Text="{Binding NotePlaceholder}" Foreground="{StaticResource Tertiary}" IsHitTestVisible="False"
                                       Visibility="{Binding Text, ElementName=NoteField, Converter={StaticResource Shown}, ConverterParameter=invert}" />
                          </Grid>
                        </Border>
                        <Grid Margin="0,8,0,0">
                          <Button Style="{StaticResource CardButton}" Content="{Binding Back}" Tag="{Binding}" Click="OnStopNote" Margin="0"
                                  Background="Transparent" BorderBrush="{StaticResource Border}" Foreground="{StaticResource Secondary}"
                                  HorizontalAlignment="Left" />
                          <Button Style="{StaticResource CardButton}" Content="{Binding Send}" Tag="{Binding}" Click="OnSendNote"
                                  Background="{StaticResource Highlight}" BorderBrush="{StaticResource Border}" HorizontalAlignment="Right" />
                        </Grid>
                      </StackPanel>
                    </StackPanel>

                    <!-- A plan its client answers itself: where to review it, and Dismiss, which answers nothing. -->
                    <StackPanel Visibility="{Binding IsPlanElsewhere, Converter={StaticResource Shown}}" Margin="0,8,0,0">
                      <TextBlock Text="{Binding Elsewhere}" Foreground="{StaticResource Secondary}" TextWrapping="Wrap" />
                      <Button Style="{StaticResource CardButton}" Content="{Binding Dismiss}" Tag="{Binding}" Click="OnLeave"
                              HorizontalAlignment="Right" Margin="0,8,0,0" Background="{StaticResource Highlight}"
                              BorderBrush="{StaticResource Border}" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ContentControl.ContentTemplate>
          </ContentControl>

          <ItemsControl ItemsSource="{Binding QueuedRequests}" Margin="10,0,10,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Tag="{Binding}" Click="OnOpenRequest" Focusable="False" Cursor="Hand" Margin="0,0,0,4">
                  <Button.Template>
                    <ControlTemplate TargetType="Button">
                      <Border x:Name="Line" Background="#14FFFFFF" CornerRadius="8" Padding="12,7">
                        <ContentPresenter />
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Line" Property="Background" Value="#26FFFFFF" /></Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Button.Template>
                  <StackPanel Orientation="Horizontal">
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource MarkTemplate}" Width="14" Height="14" />
                    <TextBlock Text="{Binding Request.Summary}" Foreground="White" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"
                               MaxWidth="330" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          </StackPanel>

          <StackPanel Visibility="{Binding ShowsUsage, Converter={StaticResource Shown}}">
          <ItemsControl ItemsSource="{Binding Agents}" Margin="16,2,16,4">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="122" />
                    <ColumnDefinition Width="64" />
                  </Grid.ColumnDefinitions>
                  <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource MarkTemplate}" Width="16" Height="16" HorizontalAlignment="Left" />
                  <TextBlock Grid.Column="1" Text="{Binding Row.ModelText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  <Grid Grid.Column="2" Width="110" Height="6" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Border CornerRadius="3" Background="{StaticResource Track}" />
                    <Border CornerRadius="3" HorizontalAlignment="Left" Background="{Binding Row.Level, Converter={StaticResource Level}}"
                            Width="{Binding UsedFraction, Converter={StaticResource Fraction}, ConverterParameter=110}" />
                  </Grid>
                  <TextBlock Grid.Column="3" Text="{Binding ResetText}" Foreground="{StaticResource Secondary}" HorizontalAlignment="Right"
                             VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Border Height="1" Background="#22FFFFFF" Margin="16,6" />

          <ItemsControl ItemsSource="{Binding Sessions}" Margin="16,0,16,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource MarkTemplate}" Width="16" Height="16"
                                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,1,0,0" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Session.Task}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Foreground="{StaticResource Secondary}" FontSize="11" TextTrimming="CharacterEllipsis">
                      <Run Text="{Binding Session.Project, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Session.PhaseText, Mode=OneWay}" />
                    </TextBlock>
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding Session.TokensText}" Foreground="{StaticResource Secondary}" Margin="10,0,0,0"
                             VerticalAlignment="Top" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          </StackPanel>
        </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Grid>
</Window>
