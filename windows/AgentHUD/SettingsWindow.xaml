<Window x:Class="AgentHUD.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="560" SizeToContent="Height" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        Background="{DynamicResource Ground}" Foreground="{DynamicResource Ink}">
  <!-- Settings → General, as the macOS Desktop's GeneralPane lays it out, in the engine's words. Every change goes to the
       engine as a patch of Core's settings, which Core validates; what is shown is the engine's next state. -->
  <Window.Resources>
    <Style x:Key="Section" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Secondary}" />
      <Setter Property="Margin" Value="4,0,0,8" />
    </Style>
    <Style x:Key="Group" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Card}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14,4" />
      <Setter Property="Margin" Value="0,0,0,24" />
    </Style>
    <Style x:Key="Note" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource Secondary}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,2,16,0" />
    </Style>
    <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
      <Setter Property="MinWidth" Value="0" />
    </Style>
    <Style x:Key="Divider" TargetType="Border">
      <Setter Property="Height" Value="1" />
      <Setter Property="Background" Value="{DynamicResource Hairline}" />
    </Style>
  </Window.Resources>

  <StackPanel Margin="24,20,24,4">
    <TextBlock x:Name="AppearanceLanguageTitle" Style="{StaticResource Section}" />
    <Border Style="{StaticResource Group}">
      <StackPanel>
        <Grid Margin="0,10">
          <TextBlock x:Name="AppearanceLabel" VerticalAlignment="Center" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <RadioButton x:Name="AppearanceSystem" GroupName="Appearance" Tag="system" Checked="OnAppearance" Margin="0,0,12,0" />
            <RadioButton x:Name="AppearanceLight" GroupName="Appearance" Tag="light" Checked="OnAppearance" Margin="0,0,12,0" />
            <RadioButton x:Name="AppearanceDark" GroupName="Appearance" Tag="dark" Checked="OnAppearance" />
          </StackPanel>
        </Grid>
        <Border Style="{StaticResource Divider}" />
        <Grid Margin="0,10">
          <TextBlock x:Name="LanguageLabel" VerticalAlignment="Center" />
          <ComboBox x:Name="LanguageChoice" Width="160" HorizontalAlignment="Right" SelectionChanged="OnLanguage" />
        </Grid>
      </StackPanel>
    </Border>

    <TextBlock x:Name="StartupTitle" Style="{StaticResource Section}" />
    <Border Style="{StaticResource Group}">
      <Grid Margin="0,10">
        <TextBlock x:Name="LaunchLabel" VerticalAlignment="Center" />
        <CheckBox x:Name="LaunchAtLogin" HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnLaunchAtLogin" />
      </Grid>
    </Border>

    <TextBlock x:Name="ClientsTitle" Style="{StaticResource Section}" />
    <Border Style="{StaticResource Group}">
      <StackPanel>
        <Grid Margin="0,10">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock x:Name="HooksLabel" />
            <TextBlock x:Name="HooksNote" Style="{StaticResource Note}" />
          </StackPanel>
          <CheckBox x:Name="ClientHooks" Grid.Column="1" VerticalAlignment="Center" Click="OnClientHooks" />
        </Grid>
        <Border Style="{StaticResource Divider}" />
        <Grid Margin="0,10">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock x:Name="WaitLabel" />
            <TextBlock x:Name="WaitNote" Style="{StaticResource Note}" />
          </StackPanel>
          <ComboBox x:Name="WaitChoice" Grid.Column="1" Width="140" VerticalAlignment="Center" SelectionChanged="OnWait" />
        </Grid>
      </StackPanel>
    </Border>
  </StackPanel>
</Window>
